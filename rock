#!/bin/bash
set -e

ROCK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLIB=sdcc_iy    # z88dk main library
RT="${ROCK_ROOT}/src"
AUTO_CAST=""
sourcefile=""
target="gcc"
nex_file=""

DEBUG=0
ALLOCATOR_STATS=0
RUN=0
ZXN_TEST=0
MEMORY_PROFILE=""
RTL_MODE="auto"
COMPONENT_MANIFEST="${ROCK_ROOT:-}/src/lib/components.manifest"
ZXN_STACK_TOP=65368
ZXN_STACK_RESERVE=2048
ZXN_BUMP_POOL_CAPACITY=1024
ZXN_LONGLIVED_POOL_CAPACITY=6144
ZXN_POOL_OPTIONS_SET=0

usage() {
  echo "usage: rock [run] [-t zxn|gcc] [--target=zxn|gcc] [--memory-profile=zxn] [--zxn-test] [--allocator-stats] [--rtl=auto|all] [--zxn-bump-pool=bytes] [--zxn-longlived-pool=bytes] [--debug] filename"
}

if [ $# -eq 0 ]; then 
  usage; exit 1
fi

COMPONENT_MANIFEST="$RT/lib/components.manifest"


transpile() {
  local target="$1" exe_abs="$2" source_abs="$3" auto_cast="$4" zxn_test="$5" memory_profile="$6"
  local extra=""
  [ -n "$auto_cast" ] && extra="--auto-cast"
  [ "$zxn_test" = "1" ] && extra="$extra --zxn-test"
  [ -n "$memory_profile" ] && extra="$extra --memory-profile=$memory_profile"
  [ "$RTL_MODE" = "all" ] && extra="$extra --components=all"
  "$ROCK_ROOT/rockc" "${source_abs}" "${exe_abs}" "--target=${target}" \
    "--component-manifest=${COMPONENT_MANIFEST}" $extra
}

append_manifest_paths() {
  local current="$1" paths="$2" item
  [ -z "$paths" ] && { printf '%s' "$current"; return; }
  local old_ifs="$IFS"
  IFS=','
  for item in $paths; do
    case "$item" in
      ''|/*|*..*|*[!A-Za-z0-9_./-]*)
        echo "invalid component source path '$item'" >&2
        exit 1
        ;;
    esac
    case " $current " in
      *" $RT/lib/$item "*) ;;
      *) current="$current $RT/lib/$item" ;;
    esac
  done
  IFS="$old_ifs"
  printf '%s' "$current"
}

manifest_component_field() {
  local id="$1" column="$2"
  awk -F'|' -v id="$id" -v column="$column" \
    '$1 == "component" && $2 == id { print $column; found=1; exit }
     END { if (!found) exit 1 }' "$COMPONENT_MANIFEST"
}

selected_component_ids() {
  local sidecar="$1"
  if [ "$RTL_MODE" = "all" ]; then
    awk -F'|' '$1 == "component" { print $2 }' "$COMPONENT_MANIFEST"
    return
  fi
  if [ ! -f "$sidecar" ] || [ "$(sed -n '1p' "$sidecar")" != "ROCK_COMPONENTS_V1" ]; then
    echo "build failed: missing or invalid compiler component output $sidecar" >&2
    exit 1
  fi
  sed -n '2,$p' "$sidecar" | sed '/^@/d'
}

selected_profile() {
  local sidecar="$1"
  sed -n 's/^@profile=//p' "$sidecar"
}

build() {
  local target="$1" exe_abs="$2" sourcefile="$3"
  local LIB_SRCS=""
  local ZXN_ASM_SRCS=""
  local zxn_test_define=""
  local allocator_stats_define=""
  local pool_fast_define=""
  local pool_capacity_defines=""
  local tiny_core_define=""
  local tiny_print_direct_define=""
  local light_core_define=""
  local zxn_startup=1
  local zxn_tiny_core=0
  local zxn_light_core=0
  local generated_source="${exe_abs}.c"
  local component_output="${exe_abs}.components"
  local generated_profile=""
  local selected_ids=""

  selected_ids="$(selected_component_ids "$component_output")"

  generated_profile="$(selected_profile "$component_output")"
  if [ "$target" = "zxn" ] && [ "$RTL_MODE" = "auto" ]; then
    case "$generated_profile" in
      tiny-31)
        zxn_tiny_core=1
        zxn_startup=31
        tiny_print_direct_define="-DROCK_ZXN_TINY_PRINT_DIRECT"
        ;;
      tiny-console-31)
        zxn_tiny_core=1
        zxn_startup=31
        tiny_print_direct_define="-DROCK_ZXN_TINY_PRINT_DIRECT -DROCK_ZXN_TINY_PRINT_CONTROLS"
        ;;
      core-31)
        zxn_light_core=1
        zxn_startup=31
        tiny_print_direct_define="-DROCK_ZXN_TINY_PRINT_DIRECT -DROCK_ZXN_TINY_PRINT_CONTROLS"
        light_core_define="-DROCK_ZXN_LIGHT_CORE"
        ;;
    esac
    if [ "$(printf '%s\n' "$selected_ids" | sed '/^core$/d;/^tiny_print$/d;/^tiny_test$/d;/^$/d' | wc -l | tr -d ' ')" -gt 0 ]; then
      zxn_tiny_core=0
      zxn_light_core=0
      zxn_startup=1
      tiny_print_direct_define=""
      light_core_define=""
    fi
    [ "$zxn_tiny_core" = "1" ] && tiny_core_define="-DROCK_ZXN_TINY_CORE"
  fi

  if ! { [ "$target" = "zxn" ] && [ "$RTL_MODE" = "auto" ] &&
         [ "$zxn_tiny_core" = "1" ]; }; then
    local component_id c_sources asm_sources c_column asm_column
    if [ "$target" = "gcc" ]; then c_column=5; asm_column=7; else c_column=6; asm_column=8; fi
    while IFS= read -r component_id; do
      case "$component_id" in
        ''|*[!a-z0-9_]*) echo "invalid component ID '$component_id'" >&2; exit 1;;
      esac
      c_sources=$(manifest_component_field "$component_id" "$c_column") || {
        echo "unknown selected component '$component_id'" >&2; exit 1; }
      asm_sources=$(manifest_component_field "$component_id" "$asm_column") || exit 1
      LIB_SRCS=$(append_manifest_paths "$LIB_SRCS" "$c_sources")
      ZXN_ASM_SRCS=$(append_manifest_paths "$ZXN_ASM_SRCS" "$asm_sources")
    done <<< "$selected_ids"
  else
    local component_id c_sources asm_sources
    while IFS= read -r component_id; do
      [ -z "$component_id" ] && continue
      c_sources=$(manifest_component_field "$component_id" 6) || exit 1
      asm_sources=$(manifest_component_field "$component_id" 8) || exit 1
      LIB_SRCS=$(append_manifest_paths "$LIB_SRCS" "$c_sources")
      ZXN_ASM_SRCS=$(append_manifest_paths "$ZXN_ASM_SRCS" "$asm_sources")
    done <<< "$selected_ids"
  fi
  echo "RTL components: $(printf '%s\n' "$selected_ids" | tr '\n' ' ')"
  echo "compile $sourcefile -> $exe_abs"

  if [ "$target" = "gcc" ]; then
    gcc -Wall -Wno-unused-variable \
      -I "${RT}/lib" -I "${RT}/ext/lib" \
      -o "${exe_abs}" "${exe_abs}.c" ${LIB_SRCS} -lm
  else
    nex_file="${exe_abs%%.*}.nex"
    [ "$ZXN_TEST" = "1" ] && zxn_test_define="-DROCK_ZXN_TEST"
    [ "$ALLOCATOR_STATS" = "1" ] && allocator_stats_define="-DROCK_ALLOCATOR_STATS"
    pool_capacity_defines="-DROCK_ZXN_BUMP_POOL_CAPACITY=$ZXN_BUMP_POOL_CAPACITY -DROCK_ZXN_LONGLIVED_POOL_CAPACITY=$ZXN_LONGLIVED_POOL_CAPACITY"
    echo "ZXN profile: startup=$zxn_startup, bump-pool=$ZXN_BUMP_POOL_CAPACITY, longlived-pool=$ZXN_LONGLIVED_POOL_CAPACITY, tiny-core=$zxn_tiny_core, light-core=$zxn_light_core"
    zcc +zxn -m -vn -subtype=nex -startup="$zxn_startup" -clib=$CLIB --opt-code-size -create-app \
      $zxn_test_define \
      $allocator_stats_define \
      $pool_fast_define \
      $pool_capacity_defines \
      $tiny_core_define \
      $tiny_print_direct_define \
      $light_core_define \
      -pragma-include:"${RT}/lib/zxn/zpragma_zxn.inc" \
      -I"${RT}/lib" \
      -lm \
      -o "${exe_abs}" \
      "${exe_abs}.c" ${LIB_SRCS} ${ZXN_ASM_SRCS}
    local map_file="${exe_abs%.*}.map"
    if [ ! -f "$map_file" ]; then
      echo "build failed: z88dk did not produce a link map"
      exit 1
    fi
    local bss_end_hex
    bss_end_hex=$(awk '$1 == "__BSS_END_head" { print $3; exit }' "$map_file")
    if [ -z "$bss_end_hex" ]; then
      echo "build failed: link map has no __BSS_END_head"
      exit 1
    fi
    local bss_end=$((16#${bss_end_hex#\$}))
    local stack_floor=$((ZXN_STACK_TOP - ZXN_STACK_RESERVE))
    if [ "$bss_end" -ge "$stack_floor" ]; then
      printf 'build failed: ZXN BSS ends at 0x%04X, entering the reserved 0x%04X-0x%04X stack range\n' \
        "$bss_end" "$stack_floor" "$ZXN_STACK_TOP"
      exit 1
    fi
    printf 'ZXN layout: BSS ends at 0x%04X; reserved stack is 0x%04X-0x%04X\n' \
      "$bss_end" "$stack_floor" "$ZXN_STACK_TOP"
    [ "$DEBUG" -eq 1 ] || rm -f "$map_file"
  fi
  if [ $? -eq 0 ]; then
    if [ "$target" = "gcc" ]; then
      echo "created $exe_abs"
    else
      rm -f "${exe_abs}"
      echo "created $nex_file"
    fi
  else
    echo "build failed"
    exit 1
  fi
}


while [ $# -gt 0 ]; do
  case "$1" in
    run)
      RUN=1
      shift 1
      ;;

    -t)
      target="${2}"
      shift 2
      ;;

    --target=*)
      target="${1#--target=}"
      shift
      ;;

    --auto-cast)
      AUTO_CAST=1; shift;;

    --zxn-test)
      ZXN_TEST=1; shift;;

    --allocator-stats)
      ALLOCATOR_STATS=1; shift;;

    --memory-profile=zxn)
      MEMORY_PROFILE="zxn"; shift;;

    --zxn-bump-pool=*)
      ZXN_BUMP_POOL_CAPACITY="${1#--zxn-bump-pool=}"
      ZXN_POOL_OPTIONS_SET=1
      shift;;

    --zxn-longlived-pool=*)
      ZXN_LONGLIVED_POOL_CAPACITY="${1#--zxn-longlived-pool=}"
      ZXN_POOL_OPTIONS_SET=1
      shift;;

    --rtl=auto)
      RTL_MODE="auto"; shift;;

    --rtl=all)
      RTL_MODE="all"; shift;;

    --debug)
      DEBUG=1; shift;;

    *) if [ "$sourcefile" = "" ]; then
         sourcefile="$1"
         source_dir=$(cd "$(dirname "$sourcefile")" && pwd)
         source_abs="${source_dir}/$(basename "$sourcefile")"
         exe_abs="${source_dir}/$(basename "${sourcefile%.*}").exe"
       else
         exe_abs="$1"
       fi
       shift
       ;;
  esac
done


if [ "$sourcefile" = "" ]; then
  usage; exit 1
fi

if [ "$ZXN_TEST" = "1" ] && [ "$target" != "zxn" ]; then
  echo "--zxn-test requires --target=zxn"
  exit 1
fi
if [ "$ZXN_POOL_OPTIONS_SET" = "1" ] && [ "$target" != "zxn" ]; then
  echo "ZXN pool capacity options require --target=zxn"
  exit 1
fi

case "$ZXN_BUMP_POOL_CAPACITY" in
  ''|*[!0-9]*)
    echo "--zxn-bump-pool requires a decimal byte count"
    exit 1
    ;;
esac
case "$ZXN_LONGLIVED_POOL_CAPACITY" in
  ''|*[!0-9]*)
    echo "--zxn-longlived-pool requires a decimal byte count"
    exit 1
    ;;
esac
if { [ "$ZXN_BUMP_POOL_CAPACITY" != "0" ] && \
     [ "${ZXN_BUMP_POOL_CAPACITY#0}" != "$ZXN_BUMP_POOL_CAPACITY" ]; } || \
   { [ "$ZXN_LONGLIVED_POOL_CAPACITY" != "0" ] && \
     [ "${ZXN_LONGLIVED_POOL_CAPACITY#0}" != "$ZXN_LONGLIVED_POOL_CAPACITY" ]; }; then
  echo "ZXN pool capacities must be canonical decimal values without leading zeros"
  exit 1
fi
if [ "${#ZXN_BUMP_POOL_CAPACITY}" -gt 5 ] || \
   [ "${#ZXN_LONGLIVED_POOL_CAPACITY}" -gt 5 ]; then
  echo "ZXN pool capacities must fit the target's 16-bit pool offsets (0..65534)"
  exit 1
fi
if [ "$ZXN_BUMP_POOL_CAPACITY" -gt 65534 ] || [ "$ZXN_LONGLIVED_POOL_CAPACITY" -gt 65534 ]; then
  echo "ZXN pool capacities must fit the target's 16-bit pool offsets (0..65534)"
  exit 1
fi
if [ "$ZXN_LONGLIVED_POOL_CAPACITY" -lt 16 ] || \
   [ $((ZXN_LONGLIVED_POOL_CAPACITY % 16)) -ne 0 ] || \
   [ "$ZXN_LONGLIVED_POOL_CAPACITY" -gt 6144 ]; then
  echo "--zxn-longlived-pool must be a multiple of 16 in the range 16..6144"
  exit 1
fi
zxn_pool_units=$((ZXN_LONGLIVED_POOL_CAPACITY / 16))
zxn_pool_roots=0
while [ "$zxn_pool_units" -gt 0 ]; do
  zxn_pool_roots=$((zxn_pool_roots + (zxn_pool_units & 1)))
  zxn_pool_units=$((zxn_pool_units >> 1))
done
if [ "$zxn_pool_roots" -gt 2 ]; then
  echo "--zxn-longlived-pool must decompose into at most two power-of-two buddy roots"
  exit 1
fi

[ $DEBUG -eq 1 ] && echo "target=$target exe=$exe_abs auto_cast=$AUTO_CAST"
transpile "$target" "$exe_abs" "$source_abs" "$AUTO_CAST" "$ZXN_TEST" "$MEMORY_PROFILE"
build "$target" "$exe_abs" "$sourcefile"

if [ $DEBUG -eq 0 ]; then
  rm -f "${exe_abs}.c"
  rm -f "${exe_abs}.components"
else
  clang-format -i "${exe_abs}.c"
fi

if [ $RUN -ne 0 ]; then
  if [ -f "$exe_abs" ]; then
    if [ "$target" = "zxn" ]; then
      zx $nex_file
    else
      $exe_abs
    fi
  fi
fi
