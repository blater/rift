#!/bin/bash
set -e

ROCK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLIB=sdcc_iy    # z88dk main library
RT="${ROCK_ROOT}/src"
AUTO_CAST=""
sourcefile=""
target="gcc"
nex_file=""

DEBUG=0
ALLOCATOR_STATS=0
RUN=0
ZXN_TEST=0
MEMORY_PROFILE=""
RTL_MODE="auto"
ZXN_STACK_TOP=65368
ZXN_STACK_RESERVE=2048
ZXN_BUMP_POOL_CAPACITY=1024
ZXN_LONGLIVED_POOL_CAPACITY=6144
ZXN_POOL_OPTIONS_SET=0

usage() {
  echo "usage: rock [run] [-t zxn|gcc] [--target=zxn|gcc] [--memory-profile=zxn] [--zxn-test] [--allocator-stats] [--rtl=auto|all] [--zxn-bump-pool=bytes] [--zxn-longlived-pool=bytes] [--debug] filename"
}

if [ $# -eq 0 ]; then 
  usage; exit 1
fi

# ---------------------------------------------------------------------------
# Rock RTL manifest
# ---------------------------------------------------------------------------
# To add a new RTL component:
#   1. Append its .c file to RTL_C_SRCS.
#   2. If it has Z80 assembly, append its .asm file to RTL_ZXN_ASM.
#   3. Register builtins and emit the #include in src/generator.c.
# See wikiroot/pages/rtl/rtl-overview.md for full conventions.
# ---------------------------------------------------------------------------

# Core runtime — always linked on both host and ZXN targets.
RTL_CORE_SRCS="\
  $RT/lib/pools.c \
  $RT/lib/print_bytes.c \
  $RT/lib/fundefs.c \
  $RT/lib/fundefs_internal.c \
  $RT/lib/asm_interop.c \
  $RT/lib/host_caps.c \
  $RT/lib/zxn_test.c"

# RTL component C shims — one line per component.
RTL_C_SRCS="\
  $RT/lib/keyboard.c \
  $RT/lib/border.c \
  $RT/lib/ink_paper.c \
  $RT/lib/cls.c \
  $RT/lib/time.c \
  $RT/lib/sound.c \
  $RT/lib/input.c \
  $RT/lib/print_at.c \
  $RT/lib/plot.c \
  $RT/lib/draw.c \
  $RT/lib/polyline.c \
  $RT/lib/circle.c \
  $RT/lib/fill.c \
  $RT/lib/triangle.c \
  $RT/lib/random.c \
  $RT/lib/nextreg.c \
  $RT/lib/helpers.c \
  $RT/lib/fmath.c"

# Host-only (gcc) extra sources — e.g. third-party single-header impl TUs.
RTL_HOST_SRCS="\
  $RT/lib/host/termbox2_impl.c"

# RTL component Z80 assembly — one line per component, ZXN target only.
RTL_ZXN_ASM="\
  $RT/lib/zxn/keyboard.asm"

# The allocator's assembly experiment remains version-controlled but is not
# linked while its target timing/correctness work is under review.  The C
# magazine implementation is the supported ZX Next allocator path.
RTL_ZXN_CORE_ASM=""


transpile() {
  local target="$1" exe_abs="$2" source_abs="$3" auto_cast="$4" zxn_test="$5" memory_profile="$6"
  local extra=""
  [ -n "$auto_cast" ] && extra="--auto-cast"
  [ "$zxn_test" = "1" ] && extra="$extra --zxn-test"
  [ -n "$memory_profile" ] && extra="$extra --memory-profile=$memory_profile"
  "$ROCK_ROOT/rockc" "${source_abs}" "${exe_abs}" "--target=${target}" $extra
}

build() {
  local target="$1" exe_abs="$2" sourcefile="$3"
  local LIB_SRCS="${RTL_CORE_SRCS} ${RTL_C_SRCS}"
  local ZXN_ASM_SRCS="${RTL_ZXN_CORE_ASM} ${RTL_ZXN_ASM}"
  local zxn_test_define=""
  local allocator_stats_define=""
  local pool_fast_define=""
  local pool_capacity_defines=""
  local tiny_core_define=""
  local zxn_startup=1
  local zxn_tiny_core=0
  local generated_source="${exe_abs}.c"
  local generated_profile=""

  IFS= read -r generated_profile < "$generated_source" || true
  if [ "$target" = "zxn" ] && [ "$RTL_MODE" = "auto" ]; then
    case "$generated_profile" in
      '/* ROCK_PROFILE:ZXN_TINY_CORE:STARTUP=31 */')
        zxn_tiny_core=1
        zxn_startup=31
        ;;
      '/* ROCK_PROFILE:ZXN_TINY_CORE:STARTUP=0 */')
        zxn_tiny_core=1
        zxn_startup=0
        ;;
      '/* ROCK_PROFILE:ZXN_TINY_CORE:STARTUP=1 */')
        zxn_tiny_core=1
        zxn_startup=1
        ;;
    esac
    [ "$zxn_tiny_core" = "1" ] && tiny_core_define="-DROCK_ZXN_TINY_CORE"
  fi

  # The complete graphical RTL is useful to developers but too large to fit
  # together with a safe stack and application data in the ZXN's flat 64 KiB
  # address space. Generated C names every runtime call, so link only the
  # components a ZXN program actually calls. `--rtl=all` remains available
  # for hand-written embedded C that cannot be found by this scan.
  if [ "$target" = "zxn" ] && [ "$RTL_MODE" = "auto" ]; then
    if [ "$zxn_tiny_core" = "1" ]; then
      LIB_SRCS=""
      if grep -Eq '(^|[^[:alnum:]_])rock_print_bytes[[:space:]]*\(' "$generated_source"; then
        LIB_SRCS="$RT/lib/print_bytes.c"
      fi
      if grep -Eq '(^|[^[:alnum:]_])zxn_test_[[:alnum:]_]*[[:space:]]*\(' "$generated_source"; then
        LIB_SRCS="$LIB_SRCS $RT/lib/zxn_test.c"
      fi
    else
      LIB_SRCS="${RTL_CORE_SRCS}"
    fi
    ZXN_ASM_SRCS="$RTL_ZXN_CORE_ASM"
    if grep -Eq '(^|[^[:alnum:]_])(scan_keyboard|key_pressed)[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/keyboard.c"
      ZXN_ASM_SRCS="$ZXN_ASM_SRCS $RT/lib/zxn/keyboard.asm"
    fi
    if grep -Eq '(^|[^[:alnum:]_])(border|border_get)[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/border.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])(ink|paper|bright|flash|inverse|over)[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/ink_paper.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])cls[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/cls.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])rock_sleep[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/time.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])beep[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/sound.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])(inkey|keypress)[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/input.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])print_at[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/print_at.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])(plot|point|draw|polyline|circle|fill|triangle|trianglefill)[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/plot.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])(draw|polyline|fill|triangle|trianglefill)[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/draw.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])polyline[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/polyline.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])circle[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/circle.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])fill[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/fill.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])(triangle|trianglefill)[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/triangle.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])(randomize|random_byte|random_word)[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/random.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])(next_reg_set|next_reg_get|cpu_speed_set|cpu_speed_get|mmu_set)[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/nextreg.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])(odd|even|hi|lo|swap|upcase|locase|abs_int|abs_word)[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/helpers.c"
    fi
    if grep -Eq '(^|[^[:alnum:]_])(fsin|fcos|fsqrt|fabs_float|fpi)[[:space:]]*\(' "$generated_source"; then
      LIB_SRCS="$LIB_SRCS $RT/lib/fmath.c"
    fi
    echo "ZXN RTL: selected components from generated program"
  fi
  echo "compile $sourcefile -> $exe_abs"

  if [ "$target" = "gcc" ]; then
    gcc -Wall -Wno-unused-variable \
      -I "${RT}/lib" -I "${RT}/ext/lib" \
      -o "${exe_abs}" "${exe_abs}.c" ${LIB_SRCS} ${RTL_HOST_SRCS} -lm
  else
    nex_file="${exe_abs%%.*}.nex"
    [ "$ZXN_TEST" = "1" ] && zxn_test_define="-DROCK_ZXN_TEST"
    [ "$ALLOCATOR_STATS" = "1" ] && allocator_stats_define="-DROCK_ALLOCATOR_STATS"
    pool_capacity_defines="-DROCK_ZXN_BUMP_POOL_CAPACITY=$ZXN_BUMP_POOL_CAPACITY -DROCK_ZXN_LONGLIVED_POOL_CAPACITY=$ZXN_LONGLIVED_POOL_CAPACITY"
    echo "ZXN profile: startup=$zxn_startup, bump-pool=$ZXN_BUMP_POOL_CAPACITY, longlived-pool=$ZXN_LONGLIVED_POOL_CAPACITY, tiny-core=$zxn_tiny_core"
    zcc +zxn -m -vn -subtype=nex -startup="$zxn_startup" -clib=$CLIB --opt-code-size -create-app \
      $zxn_test_define \
      $allocator_stats_define \
      $pool_fast_define \
      $pool_capacity_defines \
      $tiny_core_define \
      -pragma-include:"${RT}/lib/zxn/zpragma_zxn.inc" \
      -I"${RT}/lib" \
      -lm \
      -o "${exe_abs}" \
      "${exe_abs}.c" ${LIB_SRCS} ${ZXN_ASM_SRCS}
    local map_file="${exe_abs%.*}.map"
    if [ ! -f "$map_file" ]; then
      echo "build failed: z88dk did not produce a link map"
      exit 1
    fi
    local bss_end_hex
    bss_end_hex=$(awk '$1 == "__BSS_END_head" { print $3; exit }' "$map_file")
    if [ -z "$bss_end_hex" ]; then
      echo "build failed: link map has no __BSS_END_head"
      exit 1
    fi
    local bss_end=$((16#${bss_end_hex#\$}))
    local stack_floor=$((ZXN_STACK_TOP - ZXN_STACK_RESERVE))
    if [ "$bss_end" -ge "$stack_floor" ]; then
      printf 'build failed: ZXN BSS ends at 0x%04X, entering the reserved 0x%04X-0x%04X stack range\n' \
        "$bss_end" "$stack_floor" "$ZXN_STACK_TOP"
      exit 1
    fi
    printf 'ZXN layout: BSS ends at 0x%04X; reserved stack is 0x%04X-0x%04X\n' \
      "$bss_end" "$stack_floor" "$ZXN_STACK_TOP"
    [ "$DEBUG" -eq 1 ] || rm -f "$map_file"
  fi
  if [ $? -eq 0 ]; then
    if [ "$target" = "gcc" ]; then
      echo "created $exe_abs"
    else
      rm -f "${exe_abs}"
      echo "created $nex_file"
    fi
  else
    echo "build failed"
    exit 1
  fi
}


while [ $# -gt 0 ]; do
  case "$1" in
    run)
      RUN=1
      shift 1
      ;;

    -t)
      target="${2}"
      shift 2
      ;;

    --target=*)
      target="${1#--target=}"
      shift
      ;;

    --auto-cast)
      AUTO_CAST=1; shift;;

    --zxn-test)
      ZXN_TEST=1; shift;;

    --allocator-stats)
      ALLOCATOR_STATS=1; shift;;

    --memory-profile=zxn)
      MEMORY_PROFILE="zxn"; shift;;

    --zxn-bump-pool=*)
      ZXN_BUMP_POOL_CAPACITY="${1#--zxn-bump-pool=}"
      ZXN_POOL_OPTIONS_SET=1
      shift;;

    --zxn-longlived-pool=*)
      ZXN_LONGLIVED_POOL_CAPACITY="${1#--zxn-longlived-pool=}"
      ZXN_POOL_OPTIONS_SET=1
      shift;;

    --rtl=auto)
      RTL_MODE="auto"; shift;;

    --rtl=all)
      RTL_MODE="all"; shift;;

    --debug)
      DEBUG=1; shift;;

    *) if [ "$sourcefile" = "" ]; then
         sourcefile="$1"
         source_dir=$(cd "$(dirname "$sourcefile")" && pwd)
         source_abs="${source_dir}/$(basename "$sourcefile")"
         exe_abs="${source_dir}/$(basename "${sourcefile%.*}").exe"
       else
         exe_abs="$1"
       fi
       shift
       ;;
  esac
done


if [ "$sourcefile" = "" ]; then
  usage; exit 1
fi

if [ "$ZXN_TEST" = "1" ] && [ "$target" != "zxn" ]; then
  echo "--zxn-test requires --target=zxn"
  exit 1
fi
if [ "$ZXN_POOL_OPTIONS_SET" = "1" ] && [ "$target" != "zxn" ]; then
  echo "ZXN pool capacity options require --target=zxn"
  exit 1
fi

case "$ZXN_BUMP_POOL_CAPACITY" in
  ''|*[!0-9]*)
    echo "--zxn-bump-pool requires a decimal byte count"
    exit 1
    ;;
esac
case "$ZXN_LONGLIVED_POOL_CAPACITY" in
  ''|*[!0-9]*)
    echo "--zxn-longlived-pool requires a decimal byte count"
    exit 1
    ;;
esac
if { [ "$ZXN_BUMP_POOL_CAPACITY" != "0" ] && \
     [ "${ZXN_BUMP_POOL_CAPACITY#0}" != "$ZXN_BUMP_POOL_CAPACITY" ]; } || \
   { [ "$ZXN_LONGLIVED_POOL_CAPACITY" != "0" ] && \
     [ "${ZXN_LONGLIVED_POOL_CAPACITY#0}" != "$ZXN_LONGLIVED_POOL_CAPACITY" ]; }; then
  echo "ZXN pool capacities must be canonical decimal values without leading zeros"
  exit 1
fi
if [ "${#ZXN_BUMP_POOL_CAPACITY}" -gt 5 ] || \
   [ "${#ZXN_LONGLIVED_POOL_CAPACITY}" -gt 5 ]; then
  echo "ZXN pool capacities must fit the target's 16-bit pool offsets (0..65534)"
  exit 1
fi
if [ "$ZXN_BUMP_POOL_CAPACITY" -gt 65534 ] || [ "$ZXN_LONGLIVED_POOL_CAPACITY" -gt 65534 ]; then
  echo "ZXN pool capacities must fit the target's 16-bit pool offsets (0..65534)"
  exit 1
fi
if [ "$ZXN_LONGLIVED_POOL_CAPACITY" -lt 16 ] || \
   [ $((ZXN_LONGLIVED_POOL_CAPACITY % 16)) -ne 0 ] || \
   [ "$ZXN_LONGLIVED_POOL_CAPACITY" -gt 6144 ]; then
  echo "--zxn-longlived-pool must be a multiple of 16 in the range 16..6144"
  exit 1
fi
zxn_pool_units=$((ZXN_LONGLIVED_POOL_CAPACITY / 16))
zxn_pool_roots=0
while [ "$zxn_pool_units" -gt 0 ]; do
  zxn_pool_roots=$((zxn_pool_roots + (zxn_pool_units & 1)))
  zxn_pool_units=$((zxn_pool_units >> 1))
done
if [ "$zxn_pool_roots" -gt 2 ]; then
  echo "--zxn-longlived-pool must decompose into at most two power-of-two buddy roots"
  exit 1
fi

[ $DEBUG -eq 1 ] && echo "target=$target exe=$exe_abs auto_cast=$AUTO_CAST"
transpile "$target" "$exe_abs" "$source_abs" "$AUTO_CAST" "$ZXN_TEST" "$MEMORY_PROFILE"
build "$target" "$exe_abs" "$sourcefile"

if [ $DEBUG -eq 0 ]; then
  rm -f "${exe_abs}.c"
else
  clang-format -i "${exe_abs}.c"
fi

if [ $RUN -ne 0 ]; then
  if [ -f "$exe_abs" ]; then
    if [ "$target" = "zxn" ]; then
      zx $nex_file
    else
      $exe_abs
    fi
  fi
fi
