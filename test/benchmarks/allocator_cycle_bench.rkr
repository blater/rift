// A small, target-buildable workload for allocator timing. The emulator sets
// this zero-initialized flag only after it has reset its partial T-state
// counter and armed the stop breakpoint, so startup is outside the measure.
@embed c
  extern int allocator_benchmark_flag;
  int allocator_benchmark_stats[8];

  int allocator_benchmark(int phase) {
  #ifdef __SDCC
    if (phase == 0) {
      while (*(volatile int *)&allocator_benchmark_flag == 0) {
      }
      rock_allocator_stats_reset();
    }
  #endif
    if (phase == 1) {
      rock_allocator_stats stats = rock_allocator_stats_get();
      allocator_benchmark_stats[0] = stats.allocations;
      allocator_benchmark_stats[1] = stats.frees;
      allocator_benchmark_stats[2] = stats.allocation_scan_steps;
      allocator_benchmark_stats[3] = stats.free_scan_steps;
      allocator_benchmark_stats[4] = stats.coalesces;
      allocator_benchmark_stats[5] = stats.magazine_hits;
      allocator_benchmark_stats[6] = stats.buddy_splits;
      allocator_benchmark_stats[7] = stats.collect_calls;
    }
    return 0;
  }
@end c

int allocator_benchmark_flag := 0;

sub main() {
  // A NEX launch does not promise cleared BSS. Establish the gate explicitly
  // before the emulator releases it, so measurement never depends on startup.
  allocator_benchmark_flag := 0;
  allocator_benchmark(0);
  for i := 1 to 50 {
    string number := toString(i);
    string message := concat("frame-", number);
  }
  allocator_benchmark(1);
  allocator_benchmark(2);
}
