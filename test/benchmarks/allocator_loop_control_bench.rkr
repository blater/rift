// Control for allocator_primitive_cycle_bench: identical gate and loop shape,
// without managed allocation. The difference estimates allocator work.
@embed c
  extern int allocator_loop_control_flag;
  int allocator_loop_control_stats[8];

  int allocator_loop_control(int phase) {
  #ifdef __SDCC
    if (phase == 0) {
      while (*(volatile int *)&allocator_loop_control_flag == 0) {
      }
    }
  #endif
    if (phase == 1) {
      volatile int total = 0;
      int i;
      rock_allocator_stats_reset();
      for (i = 0; i < 100; i++) {
        total += i;
      }
      {
        rock_allocator_stats stats = rock_allocator_stats_get();
        allocator_loop_control_stats[0] = stats.allocations;
        allocator_loop_control_stats[1] = stats.frees;
        allocator_loop_control_stats[2] = stats.allocation_scan_steps;
        allocator_loop_control_stats[3] = stats.free_scan_steps;
        allocator_loop_control_stats[4] = stats.coalesces;
        allocator_loop_control_stats[5] = stats.magazine_hits;
        allocator_loop_control_stats[6] = stats.buddy_splits;
        allocator_loop_control_stats[7] = stats.collect_calls;
      }
    }
    return 0;
  }
@end c

int allocator_loop_control_flag := 0;

sub main() {
  allocator_loop_control_flag := 0;
  allocator_loop_control(0);
  allocator_loop_control(1);
  allocator_loop_control(2);
}
