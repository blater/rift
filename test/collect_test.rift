include "Assert.rift"
Assert a;

sub main() {
  string first := concat("safe", " point");
  a.AssertEquals("value survives collection", "safe point", first);
  // Discarded producer results coalesce immediately. The explicit safe point
  // is a counted no-op and must not disturb the still-live `first` value.
  for i := 0 to 4 {
    toString(i);
  }
  collect;
  a.AssertEquals("collection does not release live values", "safe point", first);
}
