sub show() returns int {
  return 7;
}

sub border(byte value) returns int {
  return value + 1;
}

sub sleep(word value) returns int {
  return value + 2;
}

sub print(int value) returns int {
  return value + 10;
}

sub println(int value) returns int {
  return value + 20;
}

sub concat(int left, int right) returns int {
  return left + right;
}

sub input() returns int {
  return 30;
}

sub putchar(int value) returns int {
  return value + 40;
}

sub main() {
  show();
  border(2);
  sleep(3);
  print(1);
  println(2);
  concat(3, 4);
  input();
  putchar(5);
}
