include "Assert.rift"

sub discard_input() {
  input();
}

sub return_input() returns string {
  return input();
}

sub consume_input(string value) {
}

sub pass_input() {
  consume_input(input());
}

sub print_input() {
  print(input());
}

sub concat_input() returns string {
  return concat(">", input());
}

sub exit_with_owned_values() {
  string outer := concat("outer", "-owned");
  {
    string inner := concat("inner", "-owned");
    exit(length(inner));
  }
}

sub exit_with_owned_array() {
  int[] values := [];
  append(values, 7);
  exit(length(values));
}

sub main() {
  Assert a;
  // These functions are compile-time ownership regressions. They are not
  // called here because input() is intentionally blocking.
  a.AssertEQ("input producer ownership contexts compile", 1, 1);
}
