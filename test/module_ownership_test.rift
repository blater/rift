include "Assert.rift"

record ModuleItem {
  int value,
  string label
}

include "OwnedModule.inc"

Assert as;

sub main() {
  for i := 1 to 200 {
    OwnedModule owned;
    if i = 200 {
      as.AssertEquals("module string owns its initializer", "module-title", owned.title);
      as.AssertEQ("module aggregate owns producer", 7, owned.item.value);
      as.AssertEquals("module aggregate string remains live", "module-item", owned.item.label);
      as.AssertEQ("module array owns producer", 7, get(owned.items, 0).value);
    }
  }
}
