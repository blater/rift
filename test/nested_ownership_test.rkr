include "Assert.rkr"

Assert as;

record Child {
  string name
}

record Parent {
  Child child,
  string label,
  string[] tags
}

union Envelope { Parent Present, string Message, Empty }

sub main() {
  for i := 1 to 200 {
    string[] tags;
    append(tags, concat("tag-", toString(i)));
    Child child := {name := concat("child-", toString(i))};
    Parent parent := {child := child, label := concat("parent-", toString(i)), tags := tags};
    Envelope envelope := Present(parent);
    if i = 200 {
      as.AssertEquals("nested record keeps parent string", "parent-200", parent.label);
      as.AssertEquals("nested record keeps child string", "child-200", parent.child.name);
      as.AssertEquals("nested record keeps string array", "tag-200", get(parent.tags, 0));
    }
  }
}
