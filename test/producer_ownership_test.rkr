include "Assert.rkr"

Assert as;

record Item {
  int value,
  string label
}

record Reordered {
  int code,
  Item child,
  Item[] items
}

union Box { Item Present, string Message }

sub makeItem(int n) returns Item {
  Item item := {value := n, label := concat("item-", toString(n))};
  return item;
}

sub first(Item[] items) returns Item {
  return items[0];
}

sub main() {
  for i := 1 to 200 {
    Item[] items;
    append(items, makeItem(i));
    insert(items, 0, makeItem(i));
    set(items, 1, makeItem(i));

    Item source := makeItem(i);
    Reordered reordered := {items := items, code := i, child := source};
    Item from_subscript := first(reordered.items);
    Box boxed := Present(makeItem(i));
    Box message := Message(concat("message-", toString(i)));

    if i = 200 {
      as.AssertEQ("producer array value", 200, get(reordered.items, 0).value);
      as.AssertEQ("reordered aggregate field", 200, reordered.child.value);
      as.AssertEQ("subscript return is owned once", 200, from_subscript.value);
      as.AssertEQ("producer union key", Present, boxed.key);
      as.AssertEQ("string producer union key", Message, message.key);
    }
  }
}
