// Exercises several optional RTL components in one program. The companion
// test_rtl_autolink.sh builds this for ZXN with --rtl=auto and --rtl=all to
// prove auto-link dependency selection and quantify its memory benefit.
include "Assert.rift"

sub main() {
  Assert a;

  // keyboard: C shim plus Z80 assembly dependency
  scan_keyboard();
  a.AssertEQ("out-of-range key is clear", 0, to_int(key_pressed(200)));

  // nextreg: target register wrapper (host retains a shadow implementation)
  next_reg_set(3, 170);
  a.AssertEQ("nextreg round trip", 170, to_int(next_reg_get(3)));

  // random and helpers: separate compact C RTL units
  randomize();
  byte sample := random_byte(10);
  a.AssertTrue("random byte is bounded", to_int(sample) < 10);
  a.AssertEQ("helper remains linked", 18, to_int(hi(4660)));

  // draw depends on plot; this also tests auto-link dependency expansion.
  draw(0, 0, 31, 0);
  a.AssertEQ("draw path completed", 1, 1);
}
