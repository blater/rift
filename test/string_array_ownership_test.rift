include "Assert.rift"

Assert as;

sub main() {
  for i := 1 to 300 {
    string source := concat("value-", toString(i));
    string[] values;
    append(values, source);
    insert(values, 0, source);
    string borrowed := get(values, 0);
    set(values, 1, borrowed);
    string popped := pop(values);
    if i = 300 {
      as.AssertEquals("string array insert retains source", "value-300", get(values, 0));
      as.AssertEquals("string array set retains self-alias", "value-300", popped);
    }
  }
}
