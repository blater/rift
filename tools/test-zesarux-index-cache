#!/usr/bin/env python3
"""Verify that ZEsarUX does not leave its menu index visible in $HOME."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import tempfile


DEFAULT_ZESARUX = Path("/Users/blater/src/zesarux/src/zesarux")
LEGACY_INDEX = "zesarux_index_menu.idx"
LEGACY_CONFIG = ".zesaruxrc"
CONFIG = "zesaruxrc"
ZESAR_DIR = ".zesar"


def cache_path(home):
  if os.name == "nt":
    return home / LEGACY_INDEX
  return home / ZESAR_DIR / LEGACY_INDEX


def config_path(home):
  if os.name == "nt":
    return home / LEGACY_CONFIG
  return home / ZESAR_DIR / CONFIG


class ProbeError(RuntimeError):
  pass


def run(binary, home, no_config=True, timeout=15.0):
  environment = os.environ.copy()
  environment["HOME"] = str(home)
  arguments = [str(binary)]
  if no_config:
    arguments.append("--noconfigfile")
  arguments.extend([
      "--machine", "tbblue", "--vo", "null", "--ao", "null", "--silent",
      "--noupdates", "--quickexit", "--exit-after", "1",
  ])
  try:
    return subprocess.run(
        arguments, capture_output=True, text=True, timeout=timeout, check=False,
        env=environment)
  except subprocess.TimeoutExpired as error:
    raise ProbeError("ZEsarUX did not exit within %.1fs" % timeout) from error


def require_clean_home(binary, home):
  result = run(binary, home)
  if result.returncode != 0:
    raise ProbeError(
        "ZEsarUX index-cache check failed:\n%s" %
        (result.stdout + result.stderr))

  legacy = home / LEGACY_INDEX
  cache = cache_path(home)
  if legacy.exists():
    raise ProbeError("ZEsarUX left a visible index file in HOME: %s" % legacy)
  if not cache.is_file():
    raise ProbeError("ZEsarUX did not create the menu index: %s" % cache)


def require_config_migration(binary, home):
  legacy = home / LEGACY_CONFIG
  legacy.write_text(
      "--saveconf-on-exit\n--silent\n--noupdates\n--disable-search-menu\n",
      encoding="utf-8")
  result = run(binary, home, no_config=False)
  if result.returncode != 0:
    raise ProbeError(
        "ZEsarUX configuration migration failed:\n%s" %
        (result.stdout + result.stderr))
  if legacy.exists():
    raise ProbeError("ZEsarUX left its configuration in HOME: %s" % legacy)
  migrated = config_path(home)
  if not migrated.is_file():
    raise ProbeError("ZEsarUX did not migrate its configuration: %s" % migrated)


def probe(binary):
  if not binary.is_file() or not os.access(binary, os.X_OK):
    raise ProbeError("ZEsarUX binary is not executable: %s" % binary)

  with tempfile.TemporaryDirectory(prefix="rift-zesarux-index-") as temp:
    root = Path(temp)

    fresh_home = root / "fresh-home"
    fresh_home.mkdir()
    require_clean_home(binary, fresh_home)

    migration_home = root / "migration-home"
    migration_home.mkdir()
    (migration_home / LEGACY_INDEX).write_text(
        "Main menu\nSearch entry\n\n", encoding="utf-8")
    require_clean_home(binary, migration_home)

    config_home = root / "config-home"
    config_home.mkdir()
    require_config_migration(binary, config_home)

  return {
      "binary": str(binary),
      "cache_file": str(cache_path(Path("HOME"))),
      "config_file": str(config_path(Path("HOME"))),
      "config_migration": "passed",
      "fresh_home": "clean",
      "legacy_file": "migrated",
      "status": "passed",
  }


def main():
  parser = argparse.ArgumentParser(
      description="Verify ZEsarUX menu-index cache placement")
  parser.add_argument(
      "--emulator-bin",
      default=os.environ.get("ZESARUX_BIN", str(DEFAULT_ZESARUX)))
  args = parser.parse_args()
  try:
    result = probe(Path(args.emulator_bin).expanduser().resolve())
  except (OSError, ProbeError, subprocess.SubprocessError) as error:
    print(json.dumps({"error": str(error), "status": "failed"}, sort_keys=True))
    return 1
  print(json.dumps(result, sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
